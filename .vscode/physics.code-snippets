{
    "Bold Symbol (boldsymbol)": {
        "prefix": ["bm", "\\bm", "bs", "\\boldsymbol"],
        "body": [
            "\\boldsymbol{$1}$0"
        ],
        "description": "Insert \\boldsymbol{} for bold math symbols"
    },
    "Equation Block": {
        "prefix": ["eq", "\\eq"],
        "body": [
            "$$",
            "$1",
            "$$"
        ],
        "description": "Insert LaTeX equation block"
    },
    "Inline Math": {
        "prefix": ["im", "\\im"],
        "body": [
            "\\$ $1 \\$"
        ],
        "description": "Insert inline math"
    },
    "Theorem Environment": {
        "prefix": ["theorem", "teiri"],
        "body": [
            "> [!theorem] 定理: $1",
            "> $0",
            "> ",
            "> ",
            "> ",
            "> ",
            "> ",
            "> ",
            "> "
        ],
        "description": "Insert a theorem callout with many lines"
    },
    "Proof Environment": {
        "prefix": ["proof", "shoumei"],
        "body": [
            "> [!proof] 証明",
            "> $1",
            "> ",
            "> ",
            "> ",
            "> ",
            "> ",
            "> ",
            "> ",
            "> □$0"
        ],
        "description": "Insert a proof callout with many lines"
    },
    "Bulk Callout Lines": {
        "prefix": ["...", ">>>"],
        "body": [
            "> $1",
            "> $2",
            "> $3",
            "> $4",
            "> $5$0"
        ],
        "description": "Insert 5 callout lines at once"
    },
    "Callout Line": {
        "prefix": [">", "kk"],
        "body": [
            "> $0"
        ],
        "description": "Insert a callout line marker"
    },
    "Equation in Callout": {
        "prefix": ["ceq", "cshiki"],
        "body": [
            "> $$",
            "> $1",
            "> $$$0"
        ],
        "description": "Insert an equation block inside a callout"
    },
    "Equation Environment in Callout": {
        "prefix": ["cbegeq", "cshiki-env"],
        "body": [
            "> $$",
            "> \\begin{equation}",
            ">   $1",
            "> \\end{equation}",
            "> $$$0"
        ],
        "description": "Insert a LaTeX equation environment inside a callout"
    },
    "Definition Environment": {
        "prefix": ["definition", "teigi"],
        "body": [
            "> [!info] 定義: $1",
            "> $0"
        ],
        "description": "Insert a definition callout"
    },
    "Lemma Environment": {
        "prefix": ["lemma", "hodai"],
        "body": [
            "> [!theorem] 補題: $1",
            "> $0"
        ],
        "description": "Insert a lemma callout"
    },
    "Proposition Environment": {
        "prefix": ["proposition", "meidai"],
        "body": [
            "> [!theorem] 命題: $1",
            "> $0"
        ],
        "description": "Insert a proposition callout"
    },
    "Equation Block (suushiki)": {
        "prefix": ["suushiki", "eq", "\\eq"],
        "body": [
            "$$",
            "$1",
            "$$$0"
        ],
        "description": "Insert LaTeX equation block"
    },
    "Chapter Summary": {
        "prefix": ["summary", "matome"],
        "body": [
            "## 📝 この章のまとめ",
            "> [!abstract] ポイント",
            "> - $1",
            "> - $2",
            "> ",
            "> $0"
        ],
        "description": "Insert a chapter summary section"
    },
    "Numbered Equation": {
        "prefix": ["eqnum", "shiki-ban"],
        "body": [
            "$$",
            "$1 \\tag{${2:1}}",
            "$$$0"
        ],
        "description": "Insert a numbered LaTeX equation with \\tag{}"
    },
    "Equation Environment": {
        "prefix": ["begeq", "shiki-env"],
        "body": [
            "$$",
            "\\begin{equation}",
            "  $1",
            "\\end{equation}",
            "$$$0"
        ],
        "description": "Insert a LaTeX equation environment wrapped in $$"
    },
    "Footnote Reference": {
        "prefix": ["fn", "\\fn", "kyakutyu"],
        "body": [
            "[^${1:1}]$0"
        ],
        "description": "Insert a footnote reference"
    },
    "Footnote Definition": {
        "prefix": ["fnd", "\\fnd", "kyakutyu-def"],
        "body": [
            "[^${1:1}]: $0"
        ],
        "description": "Insert a footnote definition"
    },
    "Align Environment": {
        "prefix": ["begalign", "shiki-align"],
        "body": [
            "$$",
            "\\begin{align}",
            "  $1 &= $2 \\\\",
            "  $3 &= $4",
            "\\end{align}",
            "$$$0"
        ],
        "description": "Insert a LaTeX align environment wrapped in $$"
    }
}
